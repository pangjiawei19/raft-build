# 复制到 .slockdev/local.env，由本机 .slockdev/local-dev 入口加载。
# 通用入口用法：RAFTDEV_ENV_FILE="$PWD/.slockdev/local.env" ./raftdev start raft-build
# 使用 dotenv 格式；支持注释和引号，不执行 shell，也不展开 $变量。
# 命令行显式设置的同名环境变量优先；修改后执行 restart 才作用于运行中的服务。

# 日常持久环境：保留数据，关闭公网隧道和可选的日志采集容器。
SLOCKDEV_PERSISTENT=1
SLOCKDEV_TUNNEL=0
SLOCKDEV_TRACE_OBSERVE=0
RAFTDEV_RISINGWAVE_LOW_MEMORY=1

# 已用当前源码构建 Computer 并迁移原机器后启用；沿用本环境 home 和 Agent。
# 构建：pnpm --filter @botiverse/raft-computer build。
# start／restart 会检查源码与构建记录，过期时停止本环境服务后自动构建。
# 环境正在运行时，start 只提示使用 restart，不会中断 Agent 或直接编译。
# 构建采用 Node 堆上限 1536 MiB、线程最多 2 和较低 CPU 优先级；成功后启动。
# 首次缺少记录也自动构建；构建失败时服务保持停止，保留 Agent、数据和凭据。
# 保持前台服务由 tmux 管理；首次迁移需单独执行，日常 start 不会自动创建机器。
# RAFTDEV_AGENT_HOST=computer

# 免费工作区每月上传上限，单位为字节；此处为 10 GiB。
# 留空或删除此项时使用上游默认的 100 MiB；必须为正的安全整数。
FILE_UPLOAD_MONTHLY_LIMIT_BYTES=10737418240

# 其他已有环境变量可继续添加，例如限制同时解码图片的数量。
# IMAGE_DECODE_CONCURRENCY=2
